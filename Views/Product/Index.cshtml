@model IEnumerable<HoangDuonglab5.Models.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
    var categories = ViewBag.Categories as List<HoangDuonglab5.Models.Category>;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Danh sách sản phẩm</h2>
    <a asp-action="Create" class="btn btn-primary">+ Thêm mới sản phẩm</a>
</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Mã</th>
            <th>Hình ảnh</th>
            <th>Tên sản phẩm</th>
            <th>Danh mục</th>
            <th>Giá chuẩn</th>
            <th>Giá KM</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                var catName = categories?.FirstOrDefault(c => c.Id == item.CategoryId)?.Name;
                <tr>
                    <td>@item.Id</td>
                    <td>
                        <img src="~/products/@item.Image" alt="@item.Name" width="70" height="70" style="object-fit:cover; border-radius:4px;" />
                    </td>
                    <td><strong>@item.Name</strong></td>
                    <td><span class="badge bg-secondary">@catName</span></td>
                    <td>@item.Price.ToString("N0") đ</td>
                    <td class="text-danger fw-bold">@item.SalePrice.ToString("N0") đ</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sửa</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Xem</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?');">Xóa</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center text-muted">Chưa có sản phẩm nào trong hệ thống.</td>
            </tr>
        }
    </tbody>
</table>